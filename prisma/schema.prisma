// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model User {
  id           String      @id @default(cuid())
  name         String?
  email        String?     @unique
  phone        String?     @unique
  passwordHash String?
  avatarUrl    String?
  createdAt    DateTime    @default(now())
  shortlists   Shortlist[]
}

model Manager {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  permissions  String   @default("{\"viewUsers\":true,\"viewShortlists\":true,\"viewLeads\":true}")
  isActive     Boolean  @default(true)
  createdBy    String
  createdAt    DateTime @default(now())
}

model Property {
  id                 String      @id @default(cuid())
  slug               String      @unique
  title              String
  usageType          String
  propertySubtype    String?
  areaName           String
  city               String      @default("Chennai")
  priceInr           Int
  sizeSqft           Int
  bedrooms           Int?
  bathrooms          Int?
  parking            String?
  amenities          String
  tourEmbedUrl       String
  images             String?
  floorPlans         String?
  facilities         String?
  locationAdvantages String?
  constructionStatus String?
  isNegotiable       Boolean     @default(false)
  isVerified         Boolean     @default(false)
  isBachelorFriendly Boolean     @default(false)
  isPetFriendly      Boolean     @default(false)
  isVegOnly          Boolean     @default(false)
  isPublished        Boolean     @default(false)
  isFeatured         Boolean     @default(false)
  isSold             Boolean     @default(false)
  viewCount          Int         @default(0)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  shortlists         Shortlist[]

  @@index([usageType])
  @@index([areaName])
  @@index([isPublished])
  @@index([isFeatured])
}

model Shortlist {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
}

model LeadFormResponse {
  id           String   @id @default(cuid())
  name         String
  phone        String
  email        String?
  propertyType String?
  bhk          String?
  budget       String?
  location     String?
  timeline     String?
  source       String   @default("popup")
  createdAt    DateTime @default(now())
}

model SiteSettings {
  id                  String   @id @default(cuid())
  brandName           String   @default("Realprop Realty")
  tagline             String   @default("360 Tours - Premium Properties - Chennai")
  city                String   @default("Chennai")
  whatsappNumber      String   @default("+919876543210")
  phoneNumber         String   @default("+919876543210")
  whatsappTemplate    String   @default("Hi, I am interested in {propertyTitle}. Link: {propertyUrl}")
  amenitiesVocabulary String   @default("[\"Lift\",\"Parking\",\"Security\",\"Power Backup\",\"Water Supply\",\"Gym\",\"Swimming Pool\",\"Garden\",\"Play Area\",\"Club House\"]")
  heroTitle           String?
  heroSubtitle        String?
  aboutContent        String?
  contactContent      String?
  footerText          String?
  contentSections     String?
  updatedAt           DateTime @updatedAt
}

model OnboardingSubmission {
  id              String   @id @default(cuid())
  formType        String
  status          String   @default("pending")
  name            String
  phone           String
  email           String?
  optInWhatsapp   Boolean  @default(false)
  buyerType       String?
  sellerType      String?
  propertyType    String?
  bhk             String?
  budget          String?
  areas           String?
  timeline        String?
  propertyAddress String?
  propertyDetails String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Lead {
  id        String   @id @default(cuid())
  leadType  String
  source    String   @default("onboarding_form")
  status    String   @default("new")
  name      String
  phone     String
  email     String?
  message   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChangeRequest {
  id          String   @id @default(cuid())
  type        String
  entityType  String
  entityId    String
  entityTitle String
  changes     String   @db.Text
  reason      String   @db.Text
  requestedBy String
  status      String   @default("pending")
  reviewedBy  String?
  reviewNote  String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
model CallbackRequest {
  id            String   @id @default(cuid())
  name          String
  phone         String
  propertyId    String
  propertyTitle String
  status        String   @default("pending") // pending, called, no_answer, rejected
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
